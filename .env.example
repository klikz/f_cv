# --- Ma'lumotlar bazasi ---
FCV_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/f_cv
FCV_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/f_cv_test

# --- Redis ---
FCV_REDIS_URL=redis://localhost:6379/5

# --- Ma'lumot papkalari (nisbiy yo'l repo ildiziga nisbatan) ---
FCV_DATA_DIR=data

# --- API ---
FCV_API_HOST=0.0.0.0
FCV_API_PORT=8100

# --- Telegram (bo'sh bo'lsa telegram-service kutish rejimida) ---
FCV_TELEGRAM_BOT_TOKEN=

# --- Video dekod backend: auto | vaapi | nvdec | cpu ---
FCV_DECODE_BACKEND=auto

# --- Loglash ---
FCV_LOG_LEVEL=INFO
